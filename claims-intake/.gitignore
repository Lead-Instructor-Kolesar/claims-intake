# Worktrees. These live inside the mounted path so they survive a container
# rebuild, which means git has to be told to leave them alone.
.worktrees/

# Virtual environment. Created by `uv sync` from the committed lock file.
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files. A credential in a commit is compromised and has to be
# rotated. Removing it in a later commit does not remove it from the history.
.env
*.env
!example.env

# macOS
.DS_Store
