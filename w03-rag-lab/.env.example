# Copy to .env and populate. .env is ignored and never committed.

# Anthropic, Console API key in the sk-ant-api03- format.
ANTHROPIC_API_KEY=

# Azure OpenAI. Associates create their own deployments, so the deployment
# names below are per Associate and are not shared.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
